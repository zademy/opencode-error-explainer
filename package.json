{
  "name": "opencode-error-explainer",
  "version": "0.3.1",
  "description": "An OpenCode plugin that detects failed terminal commands, classifies common errors, and explains them to the AI so debugging is faster.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format esm --target node22 --watch --out-dir dist --dts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "terminal",
    "errors",
    "debugging",
    "ai-coding",
    "error-explainer",
    "zademy"
  ],
  "author": "Zademy",
  "license": "MIT",
  "homepage": "https://zademy.com",
  "bugs": {
    "url": "https://github.com/zademy/opencode-error-explainer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zademy/opencode-error-explainer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@opencode/plugin": "^2.0.26",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.0.0"
  }
}
